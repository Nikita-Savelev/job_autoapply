# Пример env для hh_autoapply (скопируй в .env и заполни)

HH_SEARCH_URL=https://hh.ru/search/vacancy?...
HH_TARGET_ROLE=Python Backend Developer
HH_RESUME_PATH=resume/resume.txt
HH_PAUSE_SEC=2.5
# Подсветка кликов/баннер действий на экране (1=вкл, 0=выкл)
HH_HIGHLIGHT=1

# Актуальные контакты для писем (не из PDF резюме)
HH_PHONE=+7 900 000-00-00
HH_EMAIL=you@example.com
HH_TELEGRAM=@username

# OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Postgres (docker compose up -d → порт 5433)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_NAME=hh_autoapply
PG_USER=hh_autoapply
PG_PASSWORD=hh_autoapply

# Django-админка (локально: python manage.py runserver 8005)
SECRET_KEY=change-me-hh-autoapply-admin
DJANGO_DEBUG=1
