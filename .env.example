# Пример env для hh_autoapply (скопируй в .env и заполни)

# Широкий daily-поиск: Python, без региона, 100/стр, period=0 (всё время).
# Для ежедневных прогонов позже: search_period=7 (или python run_daily.py --period 7).
HH_SEARCH_URL=https://hh.ru/search/vacancy?items_on_page=100&ored_clusters=true&text=Python&search_period=0&hhtmFromLabel=search_order_button&hhtmFrom=vacancy_search_list
HH_TARGET_ROLE=Python Backend Developer
HH_RESUME_PATH=resume/resume.txt
HH_PAUSE_SEC=2.5
# Жёсткий потолок откликов за календарный день (Europe/Moscow), по БД applied_at.
# Не зависит от --apply-limit в CLI: даже при --apply-limit 500 не больше 200/день.
HH_DAILY_APPLY_LIMIT=200
# HH_DAILY_TZ=Europe/Moscow
# Чат: пауза между тредами; после sweep sleep; полный прогон раз в interval
HH_CHAT_PAUSE_SEC=30
HH_CHAT_SWEEP_SLEEP_SEC=120
HH_CHAT_SWEEP_INTERVAL_SEC=600
HH_CHAT_STOP_STREAK=3
# Подсветка кликов/баннер действий на экране (1=вкл, 0=выкл)
HH_HIGHLIGHT=1
# Бот уведомлений и капчи. Пусто — запасной BOT_TOKEN из finance_bot/.env.
HH_TG_BOT_TOKEN=

# Актуальные контакты для писем / тестов (не из PDF резюме)
HH_PHONE=+7 900 000-00-00
HH_EMAIL=you@example.com
HH_TELEGRAM=@username
HH_GITHUB=https://github.com/Nikita-Savelev

# OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Postgres (docker compose up -d → порт 5433)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_NAME=hh_autoapply
PG_USER=hh_autoapply
PG_PASSWORD=hh_autoapply

# Django-админка (локально: python manage.py runserver 8005)
SECRET_KEY=change-me-hh-autoapply-admin
DJANGO_DEBUG=1
